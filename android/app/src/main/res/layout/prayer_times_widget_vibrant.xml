<?xml version="1.0" encoding="utf-8" ?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vibrant_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_vibrant_background"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp"
>

    <!-- Location and a glanceable summary of the next prayer. -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">

        <ImageView android:layout_width="13dp" android:layout_height="13dp" android:contentDescription="@null" android:src="@drawable/ic_widget_sparkle" />

        <TextView
            android:id="@+id/vibrant_location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_default_title"
            android:textColor="#B8C4E0"
            android:textSize="11sp"
        />

        <TextView
            android:id="@+id/vibrant_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_vibrant_pill"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:paddingStart="9dp"
            android:paddingTop="3dp"
            android:paddingEnd="9dp"
            android:paddingBottom="3dp"
            android:text="@string/widget_default_next"
            android:textColor="#FFE08A"
            android:textSize="9sp"
        />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="6dp" android:layout_weight="1" android:orientation="horizontal">

        <!-- Fajr: pre-dawn indigo, crescent and stars. -->
        <FrameLayout
            android:id="@+id/vibrant_chip_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_vibrant_panel_fajr"
        >

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="3dp"
                android:layout_marginEnd="3dp"
                android:alpha="0.9"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_art_fajr"
            />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"
                android:paddingBottom="6dp"
            >

                <TextView
                    android:id="@+id/vibrant_name_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:shadowColor="#66000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:text="@string/prayer_fajr"
                    android:textColor="#FFFFFFFF"
                    android:textSize="10sp"
                />

                <TextView
                    android:id="@+id/vibrant_time_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="#66000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:text="--:--"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                />
            </LinearLayout>

            <ImageView
                android:id="@+id/vibrant_highlight_0"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_vibrant_highlight"
                android:contentDescription="@null"
                android:visibility="gone"
            />
        </FrameLayout>

        <!-- Dhuhr: bright midday sky, high sun. -->
        <FrameLayout
            android:id="@+id/vibrant_chip_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_vibrant_panel_dhuhr"
        >

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="3dp"
                android:layout_marginEnd="3dp"
                android:alpha="0.9"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_art_dhuhr"
            />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"
                android:paddingBottom="6dp"
            >

                <TextView
                    android:id="@+id/vibrant_name_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:shadowColor="#66FFFFFF"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:text="@string/prayer_dhuhr"
                    android:textColor="#FF1B2A4A"
                    android:textSize="10sp"
                />

                <TextView
                    android:id="@+id/vibrant_time_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="#66FFFFFF"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:text="--:--"
                    android:textColor="#FF1B2A4A"
                    android:textSize="12sp"
                />
            </LinearLayout>

            <ImageView
                android:id="@+id/vibrant_highlight_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_vibrant_highlight_dark"
                android:contentDescription="@null"
                android:visibility="gone"
            />
        </FrameLayout>

        <!-- Asr: violet afternoon, sun and a drifting cloud. -->
        <FrameLayout
            android:id="@+id/vibrant_chip_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_vibrant_panel_asr"
        >

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="3dp"
                android:layout_marginEnd="3dp"
                android:alpha="0.9"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_art_asr"
            />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"
                android:paddingBottom="6dp"
            >

                <TextView
                    android:id="@+id/vibrant_name_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:shadowColor="#66000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:text="@string/prayer_asr"
                    android:textColor="#FFFFFFFF"
                    android:textSize="10sp"
                />

                <TextView
                    android:id="@+id/vibrant_time_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="#66000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:text="--:--"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                />
            </LinearLayout>

            <ImageView
                android:id="@+id/vibrant_highlight_2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_vibrant_highlight"
                android:contentDescription="@null"
                android:visibility="gone"
            />
        </FrameLayout>

        <!-- Maghrib: coral sunset, sun on the horizon. -->
        <FrameLayout
            android:id="@+id/vibrant_chip_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_vibrant_panel_maghrib"
        >

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="3dp"
                android:layout_marginEnd="3dp"
                android:alpha="0.9"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_art_maghrib"
            />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"
                android:paddingBottom="6dp"
            >

                <TextView
                    android:id="@+id/vibrant_name_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:shadowColor="#66000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:text="@string/prayer_maghrib"
                    android:textColor="#FFFFFFFF"
                    android:textSize="10sp"
                />

                <TextView
                    android:id="@+id/vibrant_time_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="#66000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:text="--:--"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                />
            </LinearLayout>

            <ImageView
                android:id="@+id/vibrant_highlight_3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_vibrant_highlight"
                android:contentDescription="@null"
                android:visibility="gone"
            />
        </FrameLayout>

        <!-- Isha: deep night, crescent and stars. -->
        <FrameLayout
            android:id="@+id/vibrant_chip_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_vibrant_panel_isha"
        >

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="3dp"
                android:layout_marginEnd="3dp"
                android:alpha="0.9"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_art_isha"
            />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"
                android:paddingBottom="6dp"
            >

                <TextView
                    android:id="@+id/vibrant_name_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:shadowColor="#66000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:text="@string/prayer_isha"
                    android:textColor="#FFFFFFFF"
                    android:textSize="10sp"
                />

                <TextView
                    android:id="@+id/vibrant_time_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="#66000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:text="--:--"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                />
            </LinearLayout>

            <ImageView
                android:id="@+id/vibrant_highlight_4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_vibrant_highlight"
                android:contentDescription="@null"
                android:visibility="gone"
            />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
