<?xml version="1.0" encoding="utf-8" ?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/prayer_widget_background"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp"
>

    <!-- Location and a glanceable summary of the next prayer. -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_moon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_crescent"
        />

        <TextView
            android:id="@+id/widget_location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_default_title"
            android:textColor="@color/widget_text_muted"
            android:textSize="11sp"
        />

        <TextView
            android:id="@+id/widget_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:text="@string/widget_default_next"
            android:textAllCaps="true"
            android:textColor="@color/widget_accent"
            android:textSize="9sp"
        />
    </LinearLayout>

    <!-- RemoteViews has no plain View or Space, so the rule is a LinearLayout. -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="7dp" android:layout_marginBottom="7dp" android:background="#14FFFFFF" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/prayer_chip_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_prayer_chip"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
        >

            <TextView
                android:id="@+id/prayer_name_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:text="@string/prayer_fajr"
                android:textAllCaps="true"
                android:textColor="@color/widget_text_muted"
                android:textSize="8.5sp"
            />

            <TextView
                android:id="@+id/prayer_time_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="--:--"
                android:textColor="@color/widget_text"
                android:textSize="13sp"
            />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/prayer_chip_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_prayer_chip"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
        >

            <TextView
                android:id="@+id/prayer_name_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:text="@string/prayer_dhuhr"
                android:textAllCaps="true"
                android:textColor="@color/widget_text_muted"
                android:textSize="8.5sp"
            />

            <TextView
                android:id="@+id/prayer_time_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="--:--"
                android:textColor="@color/widget_text"
                android:textSize="13sp"
            />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/prayer_chip_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_prayer_chip"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
        >

            <TextView
                android:id="@+id/prayer_name_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:text="@string/prayer_asr"
                android:textAllCaps="true"
                android:textColor="@color/widget_text_muted"
                android:textSize="8.5sp"
            />

            <TextView
                android:id="@+id/prayer_time_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="--:--"
                android:textColor="@color/widget_text"
                android:textSize="13sp"
            />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/prayer_chip_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_prayer_chip"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
        >

            <TextView
                android:id="@+id/prayer_name_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:text="@string/prayer_maghrib"
                android:textAllCaps="true"
                android:textColor="@color/widget_text_muted"
                android:textSize="8.5sp"
            />

            <TextView
                android:id="@+id/prayer_time_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="--:--"
                android:textColor="@color/widget_text"
                android:textSize="13sp"
            />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/prayer_chip_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_prayer_chip"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
        >

            <TextView
                android:id="@+id/prayer_name_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:text="@string/prayer_isha"
                android:textAllCaps="true"
                android:textColor="@color/widget_text_muted"
                android:textSize="8.5sp"
            />

            <TextView
                android:id="@+id/prayer_time_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="--:--"
                android:textColor="@color/widget_text"
                android:textSize="13sp"
            />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
